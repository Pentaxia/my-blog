// 温暖的绿色系配色 - 像夏日树荫下的青绿，不刺眼，有温度

green-primary = #4a7c59
green-light = #6b9b6a
green-lighter = #8db580
green-bg = #f0f4ed
green-bg-alt = #e6ecde
green-text-dark = #2d4a32
green-border = #c5d4be

body
  background-color: green-bg
  color: #3a3a3a

a
  color: green-primary
  border-bottom-color: green-lighter
  &:hover
    color: green-light
    border-bottom-color: green-light

.site-title
  color: green-text-dark !important
  font-weight: 600

.site-subtitle
  color: green-light !important

.menu
  .menu-item a
    color: green-text-dark
    &:hover
      color: green-primary
  .menu-item-active a
    color: green-primary

.sidebar
  background: green-bg-alt

.sidebar-inner
  background: rgba(255, 255, 255, 0.85)

.post-block
  background: white
  border: 1px solid green-border
  border-radius: 8px
  box-shadow: 0 2px 8px rgba(74, 124, 89, 0.06)

.post-title
  color: green-text-dark

.post-meta
  color: green-light

.post-body
  h2
    border-bottom-color: green-border
    color: green-text-dark
  h3
    color: green-text-dark
  blockquote
    border-left-color: green-light
    background: green-bg
    color: #555
  code
    background: green-bg-alt
  table
    th
      background: green-bg-alt
      border-color: green-border
    td
      border-color: green-border

.pagination
  .page-number, .prev, .next
    color: green-text-dark
    &:hover
      background: green-bg-alt
  .current
    background: green-primary
    color: white
    border-color: green-primary

.post-eof
  background: green-border

.footer
  color: green-light

.tag-cloud a
  color: green-light
  &:hover
    color: green-primary

// ========== 首页 · 作品 × 流水 ==========

// 强调色板
acc-green = #4a7c59
acc-amber = #b07d29
acc-blue = #2f7f79
acc-violet = #6f5fa0
acc-slate = #6a7a70

.home-v2
  --acc: acc-green
  --acc-soft: #eaf2e4
  padding-bottom: 40px

// ---------- 主视觉 ----------
.hero
  display: grid
  grid-template-columns: 1.15fr 0.85fr
  gap: 24px
  align-items: center
  padding: 26px 8px 40px
  position: relative

.hero-copy
  min-width: 0

.hero-tag
  display: inline-flex
  align-items: center
  gap: 7px
  font-size: 0.78rem
  letter-spacing: 0.06em
  color: acc-green
  background: #eef5e8
  border: 1px solid #d9e8cd
  padding: 5px 12px
  border-radius: 20px
  margin-bottom: 18px

.dot-live
  width: 6px
  height: 6px
  border-radius: 50%
  background: #6aa84f
  box-shadow: 0 0 0 3px rgba(106, 168, 79, 0.18)
  display: inline-block

.hero-title
  font-size: clamp(2rem, 4.4vw, 2.9rem)
  line-height: 1.22
  font-weight: 700
  color: #22352a
  letter-spacing: -0.02em
  margin: 0 0 16px

  .hl
    position: relative
    color: acc-green
    display: inline-block

    &::after
      content: ''
      position: absolute
      left: -2px
      right: -2px
      bottom: 2px
      height: 9px
      background: #d6e9c4
      border-radius: 4px
      z-index: -1
      transform: rotate(-0.6deg)

.hero-sub
  font-size: 0.95rem
  line-height: 1.85
  color: #5b7163
  margin: 0 0 22px
  max-width: 30em

.hero-actions
  display: flex
  gap: 10px
  flex-wrap: wrap

.btn-solid
  display: inline-flex
  align-items: center
  gap: 6px
  background: acc-green
  color: #fff !important
  padding: 10px 20px
  border-radius: 24px
  font-size: 0.9rem
  text-decoration: none
  border-bottom: none !important
  box-shadow: 0 4px 14px rgba(74, 124, 89, 0.22)
  transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease

  &:hover
    background: #3f6e4c
    transform: translateY(-2px)
    box-shadow: 0 8px 20px rgba(74, 124, 89, 0.28)

  span
    font-size: 0.8em
    opacity: 0.8

.btn-line
  display: inline-flex
  align-items: center
  padding: 10px 18px
  border-radius: 24px
  font-size: 0.9rem
  color: #4a6455 !important
  background: #fff
  border: 1px solid #dbe7d4 !important
  text-decoration: none
  border-bottom: 1px solid #dbe7d4 !important
  transition: border-color 0.2s ease, color 0.2s ease

  &:hover
    border-color: #b7d0a6 !important
    color: acc-green !important

.hero-art
  position: relative
  display: flex
  justify-content: center
  align-items: center
  min-height: 260px

.hero-blob
  position: absolute
  width: 250px
  height: 250px
  background: radial-gradient(circle at 35% 30%, #e8f2dd, #dcecd0)
  border-radius: 56% 44% 50% 50% / 48% 52% 48% 52%
  animation: blob-morph 14s ease-in-out infinite
  z-index: 0

.hero-mascot
  position: relative
  z-index: 1
  height: 240px
  width: auto
  object-fit: contain
  filter: drop-shadow(0 12px 18px rgba(74, 124, 89, 0.16))
  animation: hero-float 5s ease-in-out infinite

.float-chip
  position: absolute
  z-index: 2
  background: #fff
  border: 1px solid #e2ede0
  color: #4a6455
  font-size: 0.72rem
  padding: 5px 11px
  border-radius: 14px
  box-shadow: 0 3px 10px rgba(60, 90, 70, 0.08)
  white-space: nowrap
  animation: chip-float 6s ease-in-out infinite

  &.fc1
    top: 12%
    left: 2%
    animation-delay: 0s

  &.fc2
    top: 40%
    right: 0%
    animation-delay: 1.4s

  &.fc3
    bottom: 16%
    left: 6%
    animation-delay: 2.6s

@keyframes blob-morph
  0%, 100%
    border-radius: 56% 44% 50% 50% / 48% 52% 48% 52%
    transform: rotate(0deg)
  50%
    border-radius: 44% 56% 46% 54% / 54% 46% 54% 46%
    transform: rotate(4deg)

@keyframes hero-float
  0%, 100%
    transform: translateY(0)
  50%
    transform: translateY(-9px)

@keyframes chip-float
  0%, 100%
    transform: translateY(0)
  50%
    transform: translateY(-6px)

// ---------- 区块标题 ----------
.sec
  padding: 8px 0 34px

.sec-hd
  display: flex
  align-items: baseline
  gap: 12px
  margin-bottom: 16px
  padding-bottom: 10px
  border-bottom: 1px solid #e7efe1

  h2
    font-size: 1.18rem
    font-weight: 700
    color: #22352a
    margin: 0
    letter-spacing: -0.01em
    white-space: nowrap

  p
    font-size: 0.8rem
    color: #90a396
    margin: 0
    line-height: 1.5

.sec-count
  display: inline-block
  margin-left: 7px
  font-size: 0.68rem
  font-weight: 600
  color: acc-green
  background: #eaf2e4
  border-radius: 9px
  padding: 1px 7px
  vertical-align: 2px

.sec-more
  display: inline-flex
  align-items: center
  gap: 5px
  font-size: 0.83rem
  color: #6d8377 !important
  text-decoration: none
  border-bottom: none !important
  margin-top: 4px
  transition: color 0.2s ease, gap 0.2s ease

  span
    transition: transform 0.2s ease

  &:hover
    color: acc-green !important

    span
      transform: translateX(3px)

.empty
  color: #a8b8ac
  font-size: 0.88rem

  code
    background: #f2f6ee
    padding: 1px 5px
    border-radius: 4px
    font-size: 0.85em

// ---------- 作品卡 ----------
.work-grid
  display: grid
  grid-template-columns: 1fr 1fr
  gap: 14px

.work-card
  --acc: acc-green
  --acc-soft: #eaf2e4
  position: relative
  background: #fff
  border: 1px solid #e3ecdd
  border-radius: 16px
  overflow: hidden
  display: flex
  flex-direction: column
  transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.3, 1), box-shadow 0.28s ease, border-color 0.28s ease

  &::before
    content: ''
    position: absolute
    top: 0
    left: 0
    right: 0
    height: 3px
    background: var(--acc)
    opacity: 0.85

  &:hover
    transform: translateY(-4px)
    border-color: #d2e2c8
    box-shadow: 0 14px 32px rgba(64, 96, 72, 0.12)

  &.acc-green
    --acc: acc-green
    --acc-soft: #eaf2e4

  &.acc-amber
    --acc: acc-amber
    --acc-soft: #fbf1de

  &.acc-blue
    --acc: acc-blue
    --acc-soft: #e3f1ef

  &.acc-violet
    --acc: acc-violet
    --acc-soft: #eeebf7

  &.acc-slate
    --acc: #6a7a70
    --acc-soft: #eef1ee

.work-lg
  grid-column: 1 / -1

  .work-name
    font-size: 1.6rem

  .work-metrics
    gap: 26px

    .wm b
      font-size: 1.65rem

.work-head
  display: flex
  align-items: center
  gap: 10px
  padding: 16px 20px 0

.work-status
  font-size: 0.7rem
  color: #6d8377
  background: #f3f6f1
  border: 1px solid #e4ebe0
  padding: 2px 9px
  border-radius: 10px
  letter-spacing: 0.02em

  &.is-live
    color: #3f6e4c
    background: #edf6e7
    border-color: #d3e7c6

.work-period
  margin-left: auto
  font-size: 0.72rem
  color: #a4b4a8
  font-variant-numeric: tabular-nums

.work-body
  padding: 12px 20px 18px
  display: flex
  flex-direction: column
  flex: 1

.work-name
  font-size: 1.22rem
  font-weight: 700
  color: #22352a
  margin: 0 0 3px
  letter-spacing: -0.01em

.work-sub
  font-size: 0.8rem
  color: var(--acc)
  margin: 0 0 11px
  font-weight: 500

.work-desc
  font-size: 0.845rem
  line-height: 1.78
  color: #5d7365
  margin: 0 0 15px

.work-metrics
  display: flex
  gap: 20px
  flex-wrap: wrap
  padding: 12px 0
  border-top: 1px dashed #e6efe0
  border-bottom: 1px dashed #e6efe0
  margin-bottom: 14px

  .wm
    display: flex
    flex-direction: column
    gap: 1px

    b
      font-size: 1.2rem
      font-weight: 700
      color: #22352a
      font-variant-numeric: tabular-nums
      line-height: 1.1

    span
      font-size: 0.68rem
      color: #9aac9f
      letter-spacing: 0.02em

.work-points
  list-style: none
  margin: 0 0 16px
  padding: 0

  li
    position: relative
    padding-left: 15px
    font-size: 0.82rem
    line-height: 1.75
    color: #5d7365
    margin-bottom: 6px

    &::before
      content: ''
      position: absolute
      left: 2px
      top: 0.66em
      width: 5px
      height: 5px
      border-radius: 50%
      background: var(--acc)
      opacity: 0.55

.work-foot
  margin-top: auto
  display: flex
  align-items: center
  gap: 10px
  flex-wrap: wrap
  padding-top: 2px

.work-role
  font-size: 0.74rem
  color: #7d9184
  background: var(--acc-soft)
  padding: 3px 9px
  border-radius: 8px

.work-stack
  display: flex
  gap: 5px
  flex-wrap: wrap
  margin-left: auto

  span
    font-size: 0.68rem
    color: #96a89b
    border: 1px solid #e8efe3
    border-radius: 6px
    padding: 1px 6px

.work-awards
  display: flex
  gap: 6px
  flex-wrap: wrap
  margin-top: 10px

.award
  font-size: 0.7rem
  color: #8a6a1f
  background: #fdf6e4
  border: 1px solid #f0e2bd
  border-radius: 7px
  padding: 2px 8px

// ---------- 产出流水 ----------
.sec-log
  position: relative

.log-line
  position: relative
  padding-left: 0
  margin-top: 4px

  &::before
    content: ''
    position: absolute
    left: 74px
    top: 6px
    bottom: 12px
    width: 1px
    background: linear-gradient(180deg, #dbe8d2 0%, #e8f0e2 70%, transparent 100%)

.log-month
  position: relative
  margin: 6px 0 12px
  padding-left: 0

  span
    display: inline-block
    font-size: 0.72rem
    font-weight: 600
    letter-spacing: 0.08em
    color: #8ba18f
    background: #f4f9f0
    border: 1px solid #e3eddb
    padding: 2px 11px
    border-radius: 10px

.log-item
  display: grid
  grid-template-columns: 60px 28px 1fr
  align-items: start
  gap: 0
  padding: 9px 0

.log-date
  display: flex
  flex-direction: column
  text-align: right
  padding-right: 14px
  padding-top: 1px

  b
    font-size: 0.8rem
    font-weight: 600
    color: #4a6455
    font-variant-numeric: tabular-nums

  span
    font-size: 0.66rem
    color: #b3c1b6
    font-variant-numeric: tabular-nums

.log-dot
  width: 9px
  height: 9px
  border-radius: 50%
  background: #fff
  border: 2px solid #b9d0aa
  margin: 5px auto 0
  position: relative
  z-index: 1
  transition: transform 0.2s ease, border-color 0.2s ease

  &.acc-green
    border-color: acc-green

  &.acc-amber
    border-color: acc-amber

  &.acc-blue
    border-color: acc-blue

  &.acc-violet
    border-color: acc-violet

  &.acc-slate
    border-color: #8d9c92

  .log-item:hover &
    transform: scale(1.3)

.log-body
  min-width: 0
  padding-left: 12px
  padding-bottom: 2px

.log-title
  font-size: 0.865rem
  line-height: 1.65
  color: #3f5449
  margin-bottom: 3px
  transition: color 0.2s ease

  .log-item:hover &
    color: #22352a

.log-meta
  display: flex
  align-items: center
  gap: 8px
  flex-wrap: wrap

.log-proj
  font-size: 0.68rem
  padding: 1px 7px
  border-radius: 6px
  background: #f2f6ef
  color: #6d8377

  &.acc-green
    background: #eaf2e4
    color: #3f6e4c

  &.acc-amber
    background: #fbf1de
    color: #8a6a1f

  &.acc-blue
    background: #e3f1ef
    color: #2a6d68

  &.acc-violet
    background: #eeebf7
    color: #5d4f8a

  &.acc-slate
    background: #eef1ee
    color: #64746a

.log-kind
  font-size: 0.66rem
  color: #a9b8ac

// ---------- 最近文章 ----------
.post-strip
  display: grid
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr))
  gap: 10px

.strip-card
  display: flex
  align-items: center
  gap: 10px
  background: #fff
  border: 1px solid #e8efe3
  border-radius: 11px
  padding: 12px 15px
  text-decoration: none
  border-bottom: 1px solid #e8efe3 !important
  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease

  &:hover
    border-color: #cfe0c4 !important
    transform: translateY(-2px)
    box-shadow: 0 6px 16px rgba(64, 96, 72, 0.08)

.strip-date
  font-size: 0.68rem
  color: #a9b8ac
  font-variant-numeric: tabular-nums
  flex: 0 0 auto

.strip-title
  font-size: 0.855rem
  color: #3f5449
  line-height: 1.5
  overflow: hidden
  display: -webkit-box
  -webkit-line-clamp: 2
  -webkit-box-orient: vertical

.strip-cat
  margin-left: auto
  font-size: 0.64rem
  color: #8ba18f
  background: #f4f9f0
  padding: 1px 6px
  border-radius: 5px
  flex: 0 0 auto

// ---------- 滚动出现 ----------
.reveal
  opacity: 0
  transform: translateY(14px)
  transition: opacity 0.55s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.3, 1)

  &.is-in
    opacity: 1
    transform: translateY(0)

@media (prefers-reduced-motion: reduce)
  .reveal
    opacity: 1
    transform: none
    transition: none

  .hero-mascot, .hero-blob, .float-chip
    animation: none

// ---------- 响应式 ----------
@media (max-width: 900px)
  .hero
    grid-template-columns: 1fr
    gap: 8px
    padding: 14px 4px 26px

  .hero-art
    order: -1
    min-height: 180px

  .hero-mascot
    height: 155px

  .hero-blob
    width: 175px
    height: 175px

  .float-chip
    font-size: 0.66rem
    padding: 4px 9px

    &.fc1
      top: 6%
      left: 6%

    &.fc2
      top: 34%
      right: 4%

    &.fc3
      bottom: 10%
      left: 10%

  .hero-title
    font-size: 1.75rem

  .hero-sub
    font-size: 0.88rem

  .work-grid
    grid-template-columns: 1fr

  .work-lg
    .work-name
      font-size: 1.35rem

    .work-metrics
      gap: 18px

      .wm b
        font-size: 1.3rem

  .sec-hd
    flex-direction: column
    gap: 3px

  .log-line
    &::before
      left: 52px

  .log-item
    grid-template-columns: 40px 24px 1fr

  .log-date
    padding-right: 8px

    b
      font-size: 0.74rem

    span
      font-size: 0.62rem

  .log-body
    padding-left: 9px

  .log-title
    font-size: 0.82rem

  .post-strip
    grid-template-columns: 1fr

// ========== Waline 评论系统样式 ==========

.waline-title
  max-width: 800px
  margin: 40px auto 12px
  font-size: 1.2em
  font-weight: 600
  color: green-text-dark
  padding-bottom: 8px
  border-bottom: 1px solid green-border

#waline-container
  max-width: 800px
  margin: 0 auto 40px
  padding: 0 4px

  .wl-btn
    border-radius: 6px

  .wl-btn.primary
    background-color: green-primary
    border-color: green-primary

    &:hover
      background-color: green-light
      border-color: green-light

  .wl-header-item label
    color: green-text-dark

  .wl-power
    color: green-light

  .wl-count
    color: green-text-dark

// ========== 卡通小人 & 开场动画 ==========

// 背景装饰
body
  background-color: #f7f9f4
  background-image:
    radial-gradient(circle at 10% 20%, rgba(139, 181, 128, 0.08) 0%, transparent 20%),
    radial-gradient(circle at 90% 80%, rgba(255, 200, 120, 0.08) 0%, transparent 20%),
    radial-gradient(circle at 50% 50%, rgba(74, 124, 89, 0.03) 0%, transparent 30%)
  background-attachment: fixed

body.intro-lock
  overflow: hidden

.post-block, .sidebar-inner, .content-wrap
  border-radius: 16px !important
  box-shadow: 0 4px 16px rgba(74, 124, 89, 0.08) !important

// ---------- 页面小人组件（透明底） ----------
.mascot-widget
  position: fixed
  bottom: 36px
  z-index: 1600
  display: flex
  align-items: flex-end
  pointer-events: none

  &.side-left
    left: -240px
    transition: left 0.55s cubic-bezier(0.34, 1.56, 0.64, 1)

    &.show
      left: 20px

  &.side-right
    right: -240px
    flex-direction: row-reverse
    transition: right 0.55s cubic-bezier(0.34, 1.56, 0.64, 1)

    &.show
      right: 20px

.mascot-figure
  position: relative

.mascot-img
  height: 170px
  width: auto
  display: block
  filter: drop-shadow(0 8px 16px rgba(45, 74, 50, 0.2))
  animation: mascot-float 3s ease-in-out infinite
  pointer-events: auto
  cursor: pointer

  &:hover
    animation: mascot-wiggle 0.6s ease-in-out

.mascot-shadow
  position: absolute
  bottom: -8px
  left: 50%
  transform: translateX(-50%)
  width: 110px
  height: 18px
  border-radius: 50%
  background: radial-gradient(ellipse, rgba(45, 74, 50, 0.2), transparent 70%)

.mascot-bubble
  position: relative
  background: rgba(255, 255, 255, 0.96)
  border: 2px solid #c5d4be
  border-radius: 20px
  padding: 13px 18px
  max-width: 230px
  font-size: 0.95em
  color: #2d4a32
  box-shadow: 0 5px 16px rgba(74, 124, 89, 0.14)
  margin-bottom: 95px
  margin-right: 14px
  opacity: 0
  transform: translateY(10px) scale(0.95)
  animation: mascot-bubble-in 0.5s ease-out 0.6s forwards
  pointer-events: auto

  &::after
    content: ''
    position: absolute
    bottom: 16px
    right: -10px
    border: 6px solid transparent
    border-left-color: rgba(255, 255, 255, 0.96)

.mascot-widget.side-right .mascot-bubble
  margin-right: 0
  margin-left: 14px

  &::after
    left: -10px
    right: auto
    border-left-color: transparent
    border-right-color: rgba(255, 255, 255, 0.96)

.mascot-close
  position: absolute
  top: -9px
  right: -9px
  width: 22px
  height: 22px
  background: #f0f4ed
  border: 1px solid #c5d4be
  border-radius: 50%
  font-size: 13px
  line-height: 20px
  text-align: center
  color: #7a9b7e
  cursor: pointer
  opacity: 0
  transition: opacity 0.2s
  pointer-events: auto

  .mascot-bubble:hover &
    opacity: 1

// ---------- 开场动画 ----------
#intro-stage
  position: fixed
  top: 0
  right: 0
  bottom: 0
  left: 0
  z-index: 2000
  background: linear-gradient(180deg, #f7f9f4 0%, #e0ecd8 60%, #d4e4cc 100%)
  display: flex
  flex-direction: column
  align-items: center
  justify-content: flex-start
  padding-top: 5vh
  overflow: hidden
  transition: opacity 0.7s ease, visibility 0.7s ease

  &.fade-out
    opacity: 0
    pointer-events: none

  &.hidden
    display: none

.intro-title
  font-size: clamp(3rem, 13vw, 8.5rem)
  font-weight: 900
  color: #4a7c59
  letter-spacing: 0.05em
  line-height: 1.15
  text-align: center
  opacity: 0
  transform: scale(0.8) translateY(-40px)
  animation: title-bloom 1.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards
  position: relative
  z-index: 3
  text-shadow: 3px 3px 0 #fff, 6px 6px 0 #c5d4be, 0 0 40px rgba(74, 124, 89, 0.25)
  -webkit-text-stroke: 2px #3d6b4a

  &::before
    content: '五次方的夏天'
    position: absolute
    left: 0
    top: 0
    width: 100%
    color: transparent
    -webkit-text-stroke: 8px rgba(125, 168, 109, 0.25)
    z-index: -1
    animation: vine-pulse 3s ease-in-out infinite

.intro-sub
  margin-top: 0.6rem
  font-size: clamp(0.95rem, 2.6vw, 1.4rem)
  color: #7a9b7e
  opacity: 0
  animation: fade-in 1s ease-out 1.5s forwards
  letter-spacing: 0.3em
  z-index: 3

.intro-vines
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  pointer-events: none
  z-index: 1

.vine-path
  fill: none
  stroke: #7da86d
  stroke-width: 3
  stroke-linecap: round
  stroke-dasharray: 1200
  stroke-dashoffset: 1200
  animation: vine-grow 2.5s ease-out forwards

  &.thick
    stroke: #6b9b6a
    stroke-width: 5

  &.thin
    stroke: #a8c99c
    stroke-width: 2

.vine-leaf
  fill: #8db580
  opacity: 0
  transform-origin: center
  animation: leaf-pop 0.5s ease-out forwards

  &.dark
    fill: #6b9b6a

  &.light
    fill: #b8d4ae

.intro-flower
  opacity: 0
  transform-origin: center
  animation: flower-pop 0.6s ease-out forwards

  &.pink
    fill: #ffb7c5

  &.yellow
    fill: #ffe082

  &.white
    fill: #fff9e6

.intro-grass
  position: absolute
  bottom: 0
  left: 0
  width: 100%
  height: 180px
  z-index: 2
  pointer-events: none

.grass-blade
  fill: none
  stroke: #7da86d
  stroke-width: 3
  stroke-linecap: round
  opacity: 0
  animation: grass-grow 0.8s ease-out forwards

  &.light
    stroke: #a8c99c

  &.dark
    stroke: #5a8a55

.intro-petal
  position: absolute
  width: 14px
  height: 14px
  background: #ffb7c5
  border-radius: 50% 0 50% 50%
  opacity: 0
  animation: petal-fall linear forwards
  z-index: 2

  &.yellow
    background: #ffe082

  &.white
    background: #fff

// 合作比心绘制区
.heart-draw-area
  position: absolute
  top: 42%
  left: 50%
  transform: translate(-50%, -50%)
  width: clamp(190px, 24vw, 280px)
  z-index: 6

  &.pop .heart-svg
    animation: heart-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)

  &.zoom
    animation: heart-zoom 0.6s cubic-bezier(0.55, 0, 0.85, 0.4) forwards

    .heart-half
      filter: none

    .heart-svg
      animation: heart-beat 0.9s ease-in-out 0.7s 2

.heart-svg
  width: 100%
  overflow: visible
  display: block

#heartFill
  opacity: 0
  transition: opacity 0.28s ease

.heart-draw-area.filled #heartFill
  opacity: 1

.heart-half
  fill: none
  stroke: #ff5f7a
  stroke-width: 7
  stroke-linecap: round
  stroke-dasharray: 100
  stroke-dashoffset: 100
  filter: drop-shadow(0 0 6px rgba(255, 95, 122, 0.55))

  &.left
    animation: draw-stroke 0.7s ease-in-out 2.3s forwards

  &.right
    animation: draw-stroke 0.7s ease-in-out 2.6s forwards

.draw-dot
  fill: #fff
  opacity: 0

  &.dot-left
    animation: dot-life 1s linear 2.3s

  &.dot-right
    animation: dot-life 1s linear 2.6s

// 开场小人
.intro-mascot
  position: absolute
  bottom: 9%
  z-index: 5
  display: flex
  flex-direction: column
  align-items: center
  opacity: 0

  &.left
    left: 15%
    animation: girl-jump-in 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) 1s forwards

  &.right
    right: 15%
    animation: boy-jump-in 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s forwards

  img
    height: clamp(180px, 32vh, 300px)
    width: auto
    filter: drop-shadow(0 12px 22px rgba(45, 74, 50, 0.2))

  &.left img
    animation: draw-hop 0.7s ease-in-out 2.3s

  &.right img
    animation: draw-hop 0.7s ease-in-out 2.6s

.intro-shadow
  width: 130px
  height: 22px
  border-radius: 50%
  background: radial-gradient(ellipse, rgba(45, 74, 50, 0.22), transparent 70%)
  margin-top: -10px

.intro-bubble
  position: absolute
  top: 60%
  left: 50%
  transform: translateX(-50%) scale(0.3) translateY(20px)
  background: rgba(255, 255, 255, 0.96)
  border: 2px solid #c5d4be
  border-radius: 24px
  padding: 14px 30px
  font-size: clamp(1.05rem, 2.8vw, 1.4rem)
  color: #2d4a32
  box-shadow: 0 8px 30px rgba(74, 124, 89, 0.2)
  z-index: 8
  white-space: nowrap
  opacity: 0
  animation: intro-bubble-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.8s forwards

  &::after
    content: ''
    position: absolute
    bottom: -12px
    left: 50%
    transform: translateX(-50%)
    border: 8px solid transparent
    border-top-color: #c5d4be

.intro-skip
  position: absolute
  bottom: 24px
  right: 24px
  padding: 10px 22px
  background: rgba(255, 255, 255, 0.85)
  border: 1px solid #c5d4be
  border-radius: 24px
  color: #7a9b7e
  cursor: pointer
  font-size: 0.95rem
  transition: all 0.2s
  z-index: 2400
  backdrop-filter: blur(4px)

  &:hover
    background: #fff
    color: #4a7c59
    transform: scale(1.05)

// 全屏爱心
#heart-screen
  position: fixed
  top: 0
  right: 0
  bottom: 0
  left: 0
  z-index: 2200
  background: #e84855
  opacity: 0
  visibility: hidden
  pointer-events: none
  transition: opacity 0.35s ease, visibility 0.35s

  &.active
    opacity: 1
    visibility: visible

  &.fade-out
    opacity: 0
    transition: opacity 0.7s ease

  &.hidden
    display: none

#mini-hearts
  position: fixed
  top: 0
  right: 0
  bottom: 0
  left: 0
  z-index: 2300
  pointer-events: none
  transition: opacity 0.7s ease

  &.fade-out
    opacity: 0

  &.hidden
    display: none

.mini-heart
  position: absolute
  width: var(--s)
  transform: scale(0) rotate(var(--r))
  animation: mini-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards, mini-bob 2.6s ease-in-out 0.55s infinite
  filter: drop-shadow(0 3px 8px rgba(140, 20, 40, 0.25))

.intro-spark
  position: absolute
  left: 50%
  top: 42%
  width: 12px
  height: 12px
  border-radius: 50%
  background: radial-gradient(circle, #fff 30%, #ffd3da 100%)
  box-shadow: 0 0 10px #ffb3c1
  animation: spark-fly 0.65s ease-out forwards

// ---------- 动画关键帧 ----------
@keyframes title-bloom
  0%
    opacity: 0
    transform: scale(0.8) translateY(-40px)
  60%
    opacity: 1
    transform: scale(1.02) translateY(5px)
  100%
    opacity: 1
    transform: scale(1) translateY(0)

@keyframes fade-in
  to
    opacity: 1

@keyframes vine-pulse
  0%, 100%
    opacity: 0.6
  50%
    opacity: 1

@keyframes vine-grow
  to
    stroke-dashoffset: 0

@keyframes leaf-pop
  0%
    opacity: 0
    transform: scale(0) rotate(-30deg)
  70%
    opacity: 1
    transform: scale(1.3) rotate(10deg)
  100%
    opacity: 1
    transform: scale(1) rotate(0)

@keyframes flower-pop
  0%
    opacity: 0
    transform: scale(0) rotate(-45deg)
  70%
    opacity: 1
    transform: scale(1.3) rotate(10deg)
  100%
    opacity: 1
    transform: scale(1) rotate(0)

@keyframes grass-grow
  0%
    opacity: 0
    transform: scaleY(0)
  100%
    opacity: 0.8
    transform: scaleY(1)

@keyframes petal-fall
  0%
    opacity: 1
    transform: translateY(-10vh) rotate(0deg)
  100%
    opacity: 0.3
    transform: translateY(110vh) rotate(360deg)

@keyframes draw-stroke
  to
    stroke-dashoffset: 0

@keyframes dot-life
  0%
    opacity: 0
  6%
    opacity: 1
  90%
    opacity: 1
  100%
    opacity: 0

@keyframes heart-pop
  0%
    transform: scale(1)
  55%
    transform: scale(1.16)
  100%
    transform: scale(1)

@keyframes heart-zoom
  from
    transform: translate(-50%, -50%) scale(1)
  to
    transform: translate(-50%, -50%) scale(30)

@keyframes heart-beat
  0%, 100%
    transform: scale(1)
  15%
    transform: scale(1.045)
  30%
    transform: scale(1)
  45%
    transform: scale(1.045)
  60%
    transform: scale(1)

@keyframes girl-jump-in
  0%
    opacity: 0
    transform: translateX(-280px) translateY(30px) scale(0.9)
  55%
    opacity: 1
    transform: translateX(24px) translateY(-48px) scale(1.05)
  78%
    transform: translateX(-8px) translateY(4px) scale(0.99)
  100%
    opacity: 1
    transform: translateX(0) translateY(0) scale(1)

@keyframes boy-jump-in
  0%
    opacity: 0
    transform: translateX(280px) translateY(30px) scale(0.9)
  55%
    opacity: 1
    transform: translateX(-24px) translateY(-48px) scale(1.05)
  78%
    transform: translateX(8px) translateY(4px) scale(0.99)
  100%
    opacity: 1
    transform: translateX(0) translateY(0) scale(1)

@keyframes draw-hop
  0%, 100%
    transform: translateY(0)
  30%
    transform: translateY(-18px)
  60%
    transform: translateY(-6px)

@keyframes intro-bubble-in
  0%
    opacity: 0
    transform: translateX(-50%) scale(0.3) translateY(20px)
  70%
    opacity: 1
    transform: translateX(-50%) scale(1.06) translateY(-4px)
  100%
    opacity: 1
    transform: translateX(-50%) scale(1) translateY(0)

@keyframes mascot-bubble-in
  0%
    opacity: 0
    transform: translateY(10px) scale(0.95)
  100%
    opacity: 1
    transform: translateY(0) scale(1)

@keyframes mini-pop
  0%
    transform: scale(0) rotate(var(--r))
  60%
    transform: scale(1.18) rotate(var(--r))
  100%
    transform: scale(1) rotate(var(--r))

@keyframes mini-bob
  0%, 100%
    transform: translateY(0) rotate(var(--r))
  50%
    transform: translateY(-9px) rotate(var(--r))

@keyframes spark-fly
  0%
    transform: translate(0, 0) scale(1)
    opacity: 1
  100%
    transform: translate(var(--dx), var(--dy)) scale(0.15)
    opacity: 0

@keyframes mascot-float
  0%, 100%
    transform: translateY(0)
  50%
    transform: translateY(-8px)

@keyframes mascot-wiggle
  0%, 100%
    transform: rotate(0deg)
  20%
    transform: rotate(-8deg)
  40%
    transform: rotate(6deg)
  60%
    transform: rotate(-4deg)
  80%
    transform: rotate(2deg)

