// 温暖的绿色系配色 - 像夏日树荫下的青绿，不刺眼，有温度

green-primary = #4a7c59
green-light = #6b9b6a
green-lighter = #8db580
green-bg = #f0f4ed
green-bg-alt = #e6ecde
green-text-dark = #2d4a32
green-border = #c5d4be

body
  background-color: green-bg
  color: #3a3a3a

a
  color: green-primary
  border-bottom-color: green-lighter
  &:hover
    color: green-light
    border-bottom-color: green-light

.site-title
  color: green-text-dark !important
  font-weight: 600

.site-subtitle
  color: green-light !important

.menu
  .menu-item a
    color: green-text-dark
    &:hover
      color: green-primary
  .menu-item-active a
    color: green-primary

.sidebar
  background: green-bg-alt

.sidebar-inner
  background: rgba(255, 255, 255, 0.85)

.post-block
  background: white
  border: 1px solid green-border
  border-radius: 8px
  box-shadow: 0 2px 8px rgba(74, 124, 89, 0.06)

.post-title
  color: green-text-dark

.post-meta
  color: green-light

.post-body
  h2
    border-bottom-color: green-border
    color: green-text-dark
  h3
    color: green-text-dark
  blockquote
    border-left-color: green-light
    background: green-bg
    color: #555
  code
    background: green-bg-alt
  table
    th
      background: green-bg-alt
      border-color: green-border
    td
      border-color: green-border

.pagination
  .page-number, .prev, .next
    color: green-text-dark
    &:hover
      background: green-bg-alt
  .current
    background: green-primary
    color: white
    border-color: green-primary

.post-eof
  background: green-border

.footer
  color: green-light

.tag-cloud a
  color: green-light
  &:hover
    color: green-primary

// ========== 首页板块样式 ==========

home-gap = 28px
home-radius = 12px

// 生活文章板块（绿色系）
.home-sections
  max-width: 800px
  margin: 0 auto
  padding: 10px 0

.home-section
  margin-bottom: home-gap
  border-radius: home-radius
  overflow: hidden

  // 生活文章（绿色）
  &:nth-child(1)
    background: #f0f4ed
    border: 1px solid #c5d4be
    box-shadow: 0 2px 10px rgba(74, 124, 89, 0.08)

  // 创赛日志（暖黄色）
  &:nth-child(2)
    background: #fefbf0
    border: 1px solid #e8dcab
    box-shadow: 0 2px 10px rgba(184, 149, 48, 0.08)

.home-section-header
  padding: 18px 24px 8px

  .home-section-title
    font-size: 1.4em
    font-weight: 600
    margin: 0
    display: flex
    align-items: center

    // 生活板块标题
    .home-section:nth-child(1) &
      color: #4a7c59

    // 创赛板块标题
    .home-section:nth-child(2) &
      color: #b89530

    .home-section-icon
      margin-right: 8px
      font-size: 1.1em

  .home-section-desc
    font-size: 0.85em
    margin: 4px 0 0
    opacity: 0.7

    .home-section:nth-child(1) &
      color: #7a9b7e

    .home-section:nth-child(2) &
      color: #b0a070

.home-post-list
  padding: 4px 24px

.home-post-card
  padding: 12px 0
  border-bottom: 1px dashed transparent
  transition: background 0.2s ease
  border-radius: 6px

  // 生活板块文章
  .home-section:nth-child(1) &
    border-bottom-color: #d5e0cc

    &:hover
      background: #e6ecde

  // 创赛板块文章
  .home-section:nth-child(2) &
    border-bottom-color: #f0e4c0

    &:hover
      background: #fbf3dc

  &:last-child
    border-bottom: none

.home-post-link
  display: flex
  align-items: center
  text-decoration: none
  border-bottom: none !important
  padding: 0 8px

  .home-post-date
    font-size: 0.85em
    margin-right: 16px
    white-space: nowrap

    .home-section:nth-child(1) &
      color: #7a9b7e

    .home-section:nth-child(2) &
      color: #b0a070

  .home-post-title
    flex: 1
    font-size: 0.95em
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

    .home-section:nth-child(1) &
      color: #2d4a32

    .home-section:nth-child(2) &
      color: #4a3d10

    &:hover
      text-decoration: none

  .home-post-tag
    font-size: 0.7em
    padding: 2px 8px
    border-radius: 10px
    margin-left: 8px
    white-space: nowrap

    .home-section:nth-child(1) &
      background: #e8f0e3
      color: #3d6b4e

    .home-section:nth-child(2) &
      background: #fcf0d4
      color: #9c7d20

.home-empty
  text-align: center
  padding: 20px 0
  color: #aaa
  font-size: 0.9em

.home-more-btn
  display: inline-block
  margin: 12px 24px 20px
  padding: 6px 20px
  border-radius: 20px
  font-size: 0.85em
  text-decoration: none
  border-bottom: none !important
  transition: all 0.25s ease

  .home-section:nth-child(1) &
    background: #4a7c59
    color: white

    &:hover
      background: #3d6b4e
      transform: scale(1.03)

  .home-section:nth-child(2) &
    background: #b89530
    color: white

    &:hover
      background: #9c7d20
      transform: scale(1.03)

// 手机端适配
@media (max-width: 767px)
  .home-sections
    padding: 0 4px

  .home-section-header
    padding: 14px 16px 6px

  .home-post-list
    padding: 4px 16px

  .home-post-link
    flex-wrap: wrap

    .home-post-title
      white-space: normal
      width: 100%
      margin-top: 2px

  .home-more-btn
    margin: 10px 16px 16px

// ========== Waline 评论系统样式 ==========

.waline-title
  max-width: 800px
  margin: 40px auto 12px
  font-size: 1.2em
  font-weight: 600
  color: green-text-dark
  padding-bottom: 8px
  border-bottom: 1px solid green-border

#waline-container
  max-width: 800px
  margin: 0 auto 40px
  padding: 0 4px

  .wl-btn
    border-radius: 6px

  .wl-btn.primary
    background-color: green-primary
    border-color: green-primary

    &:hover
      background-color: green-light
      border-color: green-light

  .wl-header-item label
    color: green-text-dark

  .wl-power
    color: green-light

  .wl-count
    color: green-text-dark

// ========== 卡通小人 & 开场动画 ==========

// 背景装饰
body
  background-color: #f7f9f4
  background-image:
    radial-gradient(circle at 10% 20%, rgba(139, 181, 128, 0.08) 0%, transparent 20%),
    radial-gradient(circle at 90% 80%, rgba(255, 200, 120, 0.08) 0%, transparent 20%),
    radial-gradient(circle at 50% 50%, rgba(74, 124, 89, 0.03) 0%, transparent 30%)
  background-attachment: fixed

body.intro-lock
  overflow: hidden

.post-block, .sidebar-inner, .content-wrap
  border-radius: 16px !important
  box-shadow: 0 4px 16px rgba(74, 124, 89, 0.08) !important

// ---------- 页面小人组件（透明底） ----------
.mascot-widget
  position: fixed
  bottom: 36px
  z-index: 1600
  display: flex
  align-items: flex-end
  pointer-events: none

  &.side-left
    left: -240px
    transition: left 0.55s cubic-bezier(0.34, 1.56, 0.64, 1)

    &.show
      left: 20px

  &.side-right
    right: -240px
    flex-direction: row-reverse
    transition: right 0.55s cubic-bezier(0.34, 1.56, 0.64, 1)

    &.show
      right: 20px

.mascot-figure
  position: relative

.mascot-img
  height: 170px
  width: auto
  display: block
  filter: drop-shadow(0 8px 16px rgba(45, 74, 50, 0.2))
  animation: mascot-float 3s ease-in-out infinite
  pointer-events: auto
  cursor: pointer

  &:hover
    animation: mascot-wiggle 0.6s ease-in-out

.mascot-shadow
  position: absolute
  bottom: -8px
  left: 50%
  transform: translateX(-50%)
  width: 110px
  height: 18px
  border-radius: 50%
  background: radial-gradient(ellipse, rgba(45, 74, 50, 0.2), transparent 70%)

.mascot-bubble
  position: relative
  background: rgba(255, 255, 255, 0.96)
  border: 2px solid #c5d4be
  border-radius: 20px
  padding: 13px 18px
  max-width: 230px
  font-size: 0.95em
  color: #2d4a32
  box-shadow: 0 5px 16px rgba(74, 124, 89, 0.14)
  margin-bottom: 95px
  margin-right: 14px
  opacity: 0
  transform: translateY(10px) scale(0.95)
  animation: mascot-bubble-in 0.5s ease-out 0.6s forwards
  pointer-events: auto

  &::after
    content: ''
    position: absolute
    bottom: 16px
    right: -10px
    border: 6px solid transparent
    border-left-color: rgba(255, 255, 255, 0.96)

.mascot-widget.side-right .mascot-bubble
  margin-right: 0
  margin-left: 14px

  &::after
    left: -10px
    right: auto
    border-left-color: transparent
    border-right-color: rgba(255, 255, 255, 0.96)

.mascot-close
  position: absolute
  top: -9px
  right: -9px
  width: 22px
  height: 22px
  background: #f0f4ed
  border: 1px solid #c5d4be
  border-radius: 50%
  font-size: 13px
  line-height: 20px
  text-align: center
  color: #7a9b7e
  cursor: pointer
  opacity: 0
  transition: opacity 0.2s
  pointer-events: auto

  .mascot-bubble:hover &
    opacity: 1

// ---------- 开场动画 ----------
#intro-stage
  position: fixed
  top: 0
  right: 0
  bottom: 0
  left: 0
  z-index: 2000
  background: linear-gradient(180deg, #f7f9f4 0%, #e0ecd8 60%, #d4e4cc 100%)
  display: flex
  flex-direction: column
  align-items: center
  justify-content: flex-start
  padding-top: 5vh
  overflow: hidden
  transition: opacity 0.7s ease, visibility 0.7s ease

  &.fade-out
    opacity: 0
    pointer-events: none

  &.hidden
    display: none

.intro-title
  font-size: clamp(3rem, 13vw, 8.5rem)
  font-weight: 900
  color: #4a7c59
  letter-spacing: 0.05em
  line-height: 1.15
  text-align: center
  opacity: 0
  transform: scale(0.8) translateY(-40px)
  animation: title-bloom 1.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards
  position: relative
  z-index: 3
  text-shadow: 3px 3px 0 #fff, 6px 6px 0 #c5d4be, 0 0 40px rgba(74, 124, 89, 0.25)
  -webkit-text-stroke: 2px #3d6b4a

  &::before
    content: '五次方的夏天'
    position: absolute
    left: 0
    top: 0
    width: 100%
    color: transparent
    -webkit-text-stroke: 8px rgba(125, 168, 109, 0.25)
    z-index: -1
    animation: vine-pulse 3s ease-in-out infinite

.intro-sub
  margin-top: 0.6rem
  font-size: clamp(0.95rem, 2.6vw, 1.4rem)
  color: #7a9b7e
  opacity: 0
  animation: fade-in 1s ease-out 1.5s forwards
  letter-spacing: 0.3em
  z-index: 3

.intro-vines
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  pointer-events: none
  z-index: 1

.vine-path
  fill: none
  stroke: #7da86d
  stroke-width: 3
  stroke-linecap: round
  stroke-dasharray: 1200
  stroke-dashoffset: 1200
  animation: vine-grow 2.5s ease-out forwards

  &.thick
    stroke: #6b9b6a
    stroke-width: 5

  &.thin
    stroke: #a8c99c
    stroke-width: 2

.vine-leaf
  fill: #8db580
  opacity: 0
  transform-origin: center
  animation: leaf-pop 0.5s ease-out forwards

  &.dark
    fill: #6b9b6a

  &.light
    fill: #b8d4ae

.intro-flower
  opacity: 0
  transform-origin: center
  animation: flower-pop 0.6s ease-out forwards

  &.pink
    fill: #ffb7c5

  &.yellow
    fill: #ffe082

  &.white
    fill: #fff9e6

.intro-grass
  position: absolute
  bottom: 0
  left: 0
  width: 100%
  height: 180px
  z-index: 2
  pointer-events: none

.grass-blade
  fill: none
  stroke: #7da86d
  stroke-width: 3
  stroke-linecap: round
  opacity: 0
  animation: grass-grow 0.8s ease-out forwards

  &.light
    stroke: #a8c99c

  &.dark
    stroke: #5a8a55

.intro-petal
  position: absolute
  width: 14px
  height: 14px
  background: #ffb7c5
  border-radius: 50% 0 50% 50%
  opacity: 0
  animation: petal-fall linear forwards
  z-index: 2

  &.yellow
    background: #ffe082

  &.white
    background: #fff

// 合作比心绘制区
.heart-draw-area
  position: absolute
  top: 42%
  left: 50%
  transform: translate(-50%, -50%)
  width: clamp(190px, 24vw, 280px)
  z-index: 6

  &.pop .heart-svg
    animation: heart-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1)

  &.zoom
    animation: heart-zoom 0.6s cubic-bezier(0.55, 0, 0.85, 0.4) forwards

    .heart-half
      filter: none

    .heart-svg
      animation: heart-beat 0.9s ease-in-out 0.7s 2

.heart-svg
  width: 100%
  overflow: visible
  display: block

#heartFill
  opacity: 0
  transition: opacity 0.28s ease

.heart-draw-area.filled #heartFill
  opacity: 1

.heart-half
  fill: none
  stroke: #ff5f7a
  stroke-width: 7
  stroke-linecap: round
  stroke-dasharray: 100
  stroke-dashoffset: 100
  filter: drop-shadow(0 0 6px rgba(255, 95, 122, 0.55))

  &.left
    animation: draw-stroke 0.7s ease-in-out 2.3s forwards

  &.right
    animation: draw-stroke 0.7s ease-in-out 2.6s forwards

.draw-dot
  fill: #fff
  opacity: 0

  &.dot-left
    animation: dot-life 1s linear 2.3s

  &.dot-right
    animation: dot-life 1s linear 2.6s

// 开场小人
.intro-mascot
  position: absolute
  bottom: 9%
  z-index: 5
  display: flex
  flex-direction: column
  align-items: center
  opacity: 0

  &.left
    left: 15%
    animation: girl-jump-in 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) 1s forwards

  &.right
    right: 15%
    animation: boy-jump-in 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s forwards

  img
    height: clamp(180px, 32vh, 300px)
    width: auto
    filter: drop-shadow(0 12px 22px rgba(45, 74, 50, 0.2))

  &.left img
    animation: draw-hop 0.7s ease-in-out 2.3s

  &.right img
    animation: draw-hop 0.7s ease-in-out 2.6s

.intro-shadow
  width: 130px
  height: 22px
  border-radius: 50%
  background: radial-gradient(ellipse, rgba(45, 74, 50, 0.22), transparent 70%)
  margin-top: -10px

.intro-bubble
  position: absolute
  top: 60%
  left: 50%
  transform: translateX(-50%) scale(0.3) translateY(20px)
  background: rgba(255, 255, 255, 0.96)
  border: 2px solid #c5d4be
  border-radius: 24px
  padding: 14px 30px
  font-size: clamp(1.05rem, 2.8vw, 1.4rem)
  color: #2d4a32
  box-shadow: 0 8px 30px rgba(74, 124, 89, 0.2)
  z-index: 8
  white-space: nowrap
  opacity: 0
  animation: intro-bubble-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.8s forwards

  &::after
    content: ''
    position: absolute
    bottom: -12px
    left: 50%
    transform: translateX(-50%)
    border: 8px solid transparent
    border-top-color: #c5d4be

.intro-skip
  position: absolute
  bottom: 24px
  right: 24px
  padding: 10px 22px
  background: rgba(255, 255, 255, 0.85)
  border: 1px solid #c5d4be
  border-radius: 24px
  color: #7a9b7e
  cursor: pointer
  font-size: 0.95rem
  transition: all 0.2s
  z-index: 2400
  backdrop-filter: blur(4px)

  &:hover
    background: #fff
    color: #4a7c59
    transform: scale(1.05)

// 全屏爱心
#heart-screen
  position: fixed
  top: 0
  right: 0
  bottom: 0
  left: 0
  z-index: 2200
  background: #e84855
  opacity: 0
  visibility: hidden
  pointer-events: none
  transition: opacity 0.35s ease, visibility 0.35s

  &.active
    opacity: 1
    visibility: visible

  &.fade-out
    opacity: 0
    transition: opacity 0.7s ease

  &.hidden
    display: none

#mini-hearts
  position: fixed
  top: 0
  right: 0
  bottom: 0
  left: 0
  z-index: 2300
  pointer-events: none
  transition: opacity 0.7s ease

  &.fade-out
    opacity: 0

  &.hidden
    display: none

.mini-heart
  position: absolute
  width: var(--s)
  transform: scale(0) rotate(var(--r))
  animation: mini-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards, mini-bob 2.6s ease-in-out 0.55s infinite
  filter: drop-shadow(0 3px 8px rgba(140, 20, 40, 0.25))

.intro-spark
  position: absolute
  left: 50%
  top: 42%
  width: 12px
  height: 12px
  border-radius: 50%
  background: radial-gradient(circle, #fff 30%, #ffd3da 100%)
  box-shadow: 0 0 10px #ffb3c1
  animation: spark-fly 0.65s ease-out forwards

// ---------- 动画关键帧 ----------
@keyframes title-bloom
  0%
    opacity: 0
    transform: scale(0.8) translateY(-40px)
  60%
    opacity: 1
    transform: scale(1.02) translateY(5px)
  100%
    opacity: 1
    transform: scale(1) translateY(0)

@keyframes fade-in
  to
    opacity: 1

@keyframes vine-pulse
  0%, 100%
    opacity: 0.6
  50%
    opacity: 1

@keyframes vine-grow
  to
    stroke-dashoffset: 0

@keyframes leaf-pop
  0%
    opacity: 0
    transform: scale(0) rotate(-30deg)
  70%
    opacity: 1
    transform: scale(1.3) rotate(10deg)
  100%
    opacity: 1
    transform: scale(1) rotate(0)

@keyframes flower-pop
  0%
    opacity: 0
    transform: scale(0) rotate(-45deg)
  70%
    opacity: 1
    transform: scale(1.3) rotate(10deg)
  100%
    opacity: 1
    transform: scale(1) rotate(0)

@keyframes grass-grow
  0%
    opacity: 0
    transform: scaleY(0)
  100%
    opacity: 0.8
    transform: scaleY(1)

@keyframes petal-fall
  0%
    opacity: 1
    transform: translateY(-10vh) rotate(0deg)
  100%
    opacity: 0.3
    transform: translateY(110vh) rotate(360deg)

@keyframes draw-stroke
  to
    stroke-dashoffset: 0

@keyframes dot-life
  0%
    opacity: 0
  6%
    opacity: 1
  90%
    opacity: 1
  100%
    opacity: 0

@keyframes heart-pop
  0%
    transform: scale(1)
  55%
    transform: scale(1.16)
  100%
    transform: scale(1)

@keyframes heart-zoom
  from
    transform: translate(-50%, -50%) scale(1)
  to
    transform: translate(-50%, -50%) scale(30)

@keyframes heart-beat
  0%, 100%
    transform: scale(1)
  15%
    transform: scale(1.045)
  30%
    transform: scale(1)
  45%
    transform: scale(1.045)
  60%
    transform: scale(1)

@keyframes girl-jump-in
  0%
    opacity: 0
    transform: translateX(-280px) translateY(30px) scale(0.9)
  55%
    opacity: 1
    transform: translateX(24px) translateY(-48px) scale(1.05)
  78%
    transform: translateX(-8px) translateY(4px) scale(0.99)
  100%
    opacity: 1
    transform: translateX(0) translateY(0) scale(1)

@keyframes boy-jump-in
  0%
    opacity: 0
    transform: translateX(280px) translateY(30px) scale(0.9)
  55%
    opacity: 1
    transform: translateX(-24px) translateY(-48px) scale(1.05)
  78%
    transform: translateX(8px) translateY(4px) scale(0.99)
  100%
    opacity: 1
    transform: translateX(0) translateY(0) scale(1)

@keyframes draw-hop
  0%, 100%
    transform: translateY(0)
  30%
    transform: translateY(-18px)
  60%
    transform: translateY(-6px)

@keyframes intro-bubble-in
  0%
    opacity: 0
    transform: translateX(-50%) scale(0.3) translateY(20px)
  70%
    opacity: 1
    transform: translateX(-50%) scale(1.06) translateY(-4px)
  100%
    opacity: 1
    transform: translateX(-50%) scale(1) translateY(0)

@keyframes mascot-bubble-in
  0%
    opacity: 0
    transform: translateY(10px) scale(0.95)
  100%
    opacity: 1
    transform: translateY(0) scale(1)

@keyframes mini-pop
  0%
    transform: scale(0) rotate(var(--r))
  60%
    transform: scale(1.18) rotate(var(--r))
  100%
    transform: scale(1) rotate(var(--r))

@keyframes mini-bob
  0%, 100%
    transform: translateY(0) rotate(var(--r))
  50%
    transform: translateY(-9px) rotate(var(--r))

@keyframes spark-fly
  0%
    transform: translate(0, 0) scale(1)
    opacity: 1
  100%
    transform: translate(var(--dx), var(--dy)) scale(0.15)
    opacity: 0

@keyframes mascot-float
  0%, 100%
    transform: translateY(0)
  50%
    transform: translateY(-8px)

@keyframes mascot-wiggle
  0%, 100%
    transform: rotate(0deg)
  20%
    transform: rotate(-8deg)
  40%
    transform: rotate(6deg)
  60%
    transform: rotate(-4deg)
  80%
    transform: rotate(2deg)

// ---------- 移动端适配 ----------
@media (max-width: 640px)
  .intro-title
    font-size: 2.8rem
    -webkit-text-stroke: 1.5px #3d6b4a

    &::before
      -webkit-text-stroke: 5px rgba(125, 168, 109, 0.25)

