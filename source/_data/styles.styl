// 温暖的绿色系配色 - 像夏日树荫下的青绿，不刺眼，有温度

green-primary = #4a7c59
green-light = #6b9b6a
green-lighter = #8db580
green-bg = #f0f4ed
green-bg-alt = #e6ecde
green-text-dark = #2d4a32
green-border = #c5d4be

body
  background-color: green-bg
  color: #3a3a3a

a
  color: green-primary
  border-bottom-color: green-lighter
  &:hover
    color: green-light
    border-bottom-color: green-light

.site-title
  color: green-text-dark !important
  font-weight: 600

.site-subtitle
  color: green-light !important

.menu
  .menu-item a
    color: green-text-dark
    &:hover
      color: green-primary
  .menu-item-active a
    color: green-primary

.sidebar
  background: green-bg-alt

.sidebar-inner
  background: rgba(255, 255, 255, 0.85)

.post-block
  background: white
  border: 1px solid green-border
  border-radius: 8px
  box-shadow: 0 2px 8px rgba(74, 124, 89, 0.06)

.post-title
  color: green-text-dark

.post-meta
  color: green-light

.post-body
  h2
    border-bottom-color: green-border
    color: green-text-dark
  h3
    color: green-text-dark
  blockquote
    border-left-color: green-light
    background: green-bg
    color: #555
  code
    background: green-bg-alt
  table
    th
      background: green-bg-alt
      border-color: green-border
    td
      border-color: green-border

.pagination
  .page-number, .prev, .next
    color: green-text-dark
    &:hover
      background: green-bg-alt
  .current
    background: green-primary
    color: white
    border-color: green-primary

.post-eof
  background: green-border

.footer
  color: green-light

.tag-cloud a
  color: green-light
  &:hover
    color: green-primary

// ========== 首页板块样式 ==========

home-gap = 28px
home-radius = 12px

// 生活文章板块（绿色系）
.home-sections
  max-width: 800px
  margin: 0 auto
  padding: 10px 0

.home-section
  margin-bottom: home-gap
  border-radius: home-radius
  overflow: hidden

  // 生活文章（绿色）
  &:nth-child(1)
    background: #f0f4ed
    border: 1px solid #c5d4be
    box-shadow: 0 2px 10px rgba(74, 124, 89, 0.08)

  // 创赛日志（暖黄色）
  &:nth-child(2)
    background: #fefbf0
    border: 1px solid #e8dcab
    box-shadow: 0 2px 10px rgba(184, 149, 48, 0.08)

.home-section-header
  padding: 18px 24px 8px

  .home-section-title
    font-size: 1.4em
    font-weight: 600
    margin: 0
    display: flex
    align-items: center

    // 生活板块标题
    .home-section:nth-child(1) &
      color: #4a7c59

    // 创赛板块标题
    .home-section:nth-child(2) &
      color: #b89530

    .home-section-icon
      margin-right: 8px
      font-size: 1.1em

  .home-section-desc
    font-size: 0.85em
    margin: 4px 0 0
    opacity: 0.7

    .home-section:nth-child(1) &
      color: #7a9b7e

    .home-section:nth-child(2) &
      color: #b0a070

.home-post-list
  padding: 4px 24px

.home-post-card
  padding: 12px 0
  border-bottom: 1px dashed transparent
  transition: background 0.2s ease
  border-radius: 6px

  // 生活板块文章
  .home-section:nth-child(1) &
    border-bottom-color: #d5e0cc

    &:hover
      background: #e6ecde

  // 创赛板块文章
  .home-section:nth-child(2) &
    border-bottom-color: #f0e4c0

    &:hover
      background: #fbf3dc

  &:last-child
    border-bottom: none

.home-post-link
  display: flex
  align-items: center
  text-decoration: none
  border-bottom: none !important
  padding: 0 8px

  .home-post-date
    font-size: 0.85em
    margin-right: 16px
    white-space: nowrap

    .home-section:nth-child(1) &
      color: #7a9b7e

    .home-section:nth-child(2) &
      color: #b0a070

  .home-post-title
    flex: 1
    font-size: 0.95em
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

    .home-section:nth-child(1) &
      color: #2d4a32

    .home-section:nth-child(2) &
      color: #4a3d10

    &:hover
      text-decoration: none

  .home-post-tag
    font-size: 0.7em
    padding: 2px 8px
    border-radius: 10px
    margin-left: 8px
    white-space: nowrap

    .home-section:nth-child(1) &
      background: #e8f0e3
      color: #3d6b4e

    .home-section:nth-child(2) &
      background: #fcf0d4
      color: #9c7d20

.home-empty
  text-align: center
  padding: 20px 0
  color: #aaa
  font-size: 0.9em

.home-more-btn
  display: inline-block
  margin: 12px 24px 20px
  padding: 6px 20px
  border-radius: 20px
  font-size: 0.85em
  text-decoration: none
  border-bottom: none !important
  transition: all 0.25s ease

  .home-section:nth-child(1) &
    background: #4a7c59
    color: white

    &:hover
      background: #3d6b4e
      transform: scale(1.03)

  .home-section:nth-child(2) &
    background: #b89530
    color: white

    &:hover
      background: #9c7d20
      transform: scale(1.03)

// 手机端适配
@media (max-width: 767px)
  .home-sections
    padding: 0 4px

  .home-section-header
    padding: 14px 16px 6px

  .home-post-list
    padding: 4px 16px

  .home-post-link
    flex-wrap: wrap

    .home-post-title
      white-space: normal
      width: 100%
      margin-top: 2px

  .home-more-btn
    margin: 10px 16px 16px

// ========== Giscus 评论系统样式 ==========

.giscus-container
  max-width: 800px
  margin: 40px auto 20px
  padding: 24px
  background: white
  border: 1px solid green-border
  border-radius: 12px
  box-shadow: 0 2px 8px rgba(74, 124, 89, 0.06)

.giscus-title
  font-size: 1.2em
  font-weight: 600
  color: green-text-dark
  margin-bottom: 16px
  padding-bottom: 8px
  border-bottom: 1px solid green-border

.giscus-frame
  width: 100% !important
