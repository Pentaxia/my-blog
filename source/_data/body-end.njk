{# Waline 评论系统 - 只在文章页面加载 #}
{%- if page.comments !== false and page.layout === 'post' %}
<div class="waline-title">💬 评论</div>
<link rel="stylesheet" href="/lib/waline/waline.css" />
<div id="waline-container"></div>
<script type="module">
  import { init } from '/lib/waline/waline.js';
  init({
    el: '#waline-container',
    serverURL: window.location.origin,
    lang: 'zh-CN',
    emoji: ['/lib/waline/weibo'],
    search: true,
    copyright: false,
  });
</script>
{%- endif %}

{# 开场动画 - 仅首页第一页 #}
{%- if page.path === 'index.html' %}
