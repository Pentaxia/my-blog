  </svg>

  <svg class="intro-grass" viewBox="0 0 1200 180" preserveAspectRatio="none">
    <path class="grass-blade" d="M50,180 Q60,120 70,180" style="animation-delay:1.8s" />
    <path class="grass-blade light" d="M90,180 Q100,100 110,180" style="animation-delay:1.9s" />
    <path class="grass-blade dark" d="M140,180 Q150,130 160,180" style="animation-delay:2s" />
