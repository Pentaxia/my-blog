  <h1 class="intro-title">五次方的夏天</h1>
  <p class="intro-sub">夏夏夏夏夏 的个人博客</p>

  <div class="heart-draw-area" id="heart-area">
    <svg class="heart-svg" viewBox="0 0 300 280">
      <defs>
        <linearGradient id="hg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ff9aa8" />
          <stop offset="1" stop-color="#e84855" />
        </linearGradient>
      </defs>
      <path id="heartFill" d="M150,252 C150,252 18,168 18,98 C18,52 52,22 88,22 C114,22 138,38 150,58 C162,38 186,22 212,22 C248,22 282,52 282,98 C282,168 150,252 150,252 Z" fill="url(#hg)" />
