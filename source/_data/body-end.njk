<div id="heart-screen"></div>
<div id="mini-hearts"></div>
{%- endif %}

{# 卡通小人引导组件 #}
<div id="mascot-widget" class="mascot-widget side-left">
  <div class="mascot-figure">
    <img id="mascot-img" class="mascot-img" alt="小向导" />
    <div class="mascot-shadow"></div>
  </div>
  <div class="mascot-bubble" id="mascot-bubble">
    <span class="mascot-close" id="mascot-close" title="隐藏一天">×</span>
    <span id="mascot-text"></span>
  </div>
</div>

<script>
(function () {
  var month = new Date().getMonth() + 1;
  var season = 'winter';
  if (month >= 3 && month <= 5) season = 'spring';
  else if (month >= 6 && month <= 8) season = 'summer';
  else if (month >= 9 && month <= 11) season = 'autumn';
  var seasonSuffix = season === 'summer' ? '' : '-' + season;
  var savedGirl = localStorage.getItem('dressup-girl');
  var savedBoy = localStorage.getItem('dressup-boy');
  var girlImg = savedGirl ? '/images/dressup-girl-' + savedGirl + '.png' : '/images/mascot-girl' + seasonSuffix + '.png';
  var boyImg = savedBoy ? '/images/dressup-boy-' + savedBoy + '.png' : '/images/mascot-boy' + seasonSuffix + '.png';

  var widget = document.getElementById('mascot-widget');
  var mImg = document.getElementById('mascot-img');
  var bubble = document.getElementById('mascot-bubble');
  var mText = document.getElementById('mascot-text');
  var closeBtn = document.getElementById('mascot-close');

  var closedAt = localStorage.getItem('mascot-closed-at');
  var mascotEnabled = !(closedAt && Date.now() - parseInt(closedAt, 10) < 86400000);

  var currentScene = null;

  var scenes = {
    home: { side: 'side-left', img: girlImg, text: '点进文章标题看看全文吧~' },
    'post-top': { side: 'side-right', img: boyImg, text: '拉到底部还可以评论哦！' },
    'post-bottom': { side: 'side-left', img: girlImg, text: '还可以发图片和表情包，快来试试吧~' }
  };

  function showScene(name) {
    if (!mascotEnabled || name === currentScene) return;
    var s = scenes[name];
    if (!s) return;
    currentScene = name;
    widget.classList.remove('show');
    setTimeout(function () {
      widget.className = 'mascot-widget ' + s.side;
      mImg.src = s.img;
      mText.textContent = s.text;
      bubble.style.animation = 'none';
      void bubble.offsetWidth;
      bubble.style.animation = '';
      requestAnimationFrame(function () { widget.classList.add('show'); });
    }, 250);
  }

  closeBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    mascotEnabled = false;
    widget.classList.remove('show');
    localStorage.setItem('mascot-closed-at', String(Date.now()));
  });

  mImg.addEventListener('click', function () {
    bubble.style.display = bubble.style.display === 'none' ? 'block' : 'none';
  });

  var isPost = !!document.getElementById('waline-container');
  var introStage = document.getElementById('intro-stage');

  // ===== 开场动画 =====
  if (introStage) {
    document.getElementById('intro-girl-img').src = girlImg;
    document.getElementById('intro-boy-img').src = boyImg;

    var heartArea = document.getElementById('heart-area');
    var heartScreen = document.getElementById('heart-screen');
    var miniHearts = document.getElementById('mini-hearts');
    var skipBtn = document.getElementById('intro-skip');
    var timers = [];

    function at(ms, fn) { timers.push(setTimeout(fn, ms)); }

    function endIntro() {
      timers.forEach(clearTimeout);
      sessionStorage.setItem('intro-played', '1');
      introStage.classList.add('hidden');
      heartScreen.classList.add('hidden');
      miniHearts.classList.add('hidden');
      document.body.classList.remove('intro-lock');
      showScene('home');
    }

    if (sessionStorage.getItem('intro-played')) {
      introStage.classList.add('hidden');
      heartScreen.classList.add('hidden');
      miniHearts.classList.add('hidden');
      showScene('home');
    } else {
      document.body.classList.add('intro-lock');

      // 飘落花瓣
      var petalBox = document.getElementById('intro-petals');
      var pcolors = ['', 'yellow', 'white'];
      for (var i = 0; i < 26; i++) {
        var p = document.createElement('div');
        p.className = 'intro-petal ' + pcolors[i % 3];
        p.style.left = Math.random() * 100 + '%';
        p.style.animationDuration = (6 + Math.random() * 8) + 's';
        p.style.animationDelay = (Math.random() * 5) + 's';
        var ps = 10 + Math.random() * 8;
        p.style.width = ps + 'px';
        p.style.height = ps + 'px';
        petalBox.appendChild(p);
      }

      var HEART_SVG = '<svg viewBox="0 0 100 90"><path d="M50,85 C50,85 5,55 5,25 C5,10 17,2 29,2 C38,2 46,8 50,15 C54,8 62,2 71,2 C83,2 95,10 95,25 C95,55 50,85 50,85 Z" fill="{C}"/></svg>';
      var PALETTE = ['#ffffff', '#ffd3da', '#ffb3c1', '#fff3b0', '#ffd6a5', '#b7e4c7', '#ffe5ec'];

      function sparkleBurst() {
        for (var i = 0; i < 12; i++) {
          var s = document.createElement('div');
          s.className = 'intro-spark';
          var ang = Math.PI * 2 * i / 12 + Math.random() * 0.5;
          var dist = 90 + Math.random() * 80;
          s.style.setProperty('--dx', Math.cos(ang) * dist + 'px');
          s.style.setProperty('--dy', Math.sin(ang) * dist + 'px');
          s.style.animationDelay = (Math.random() * 0.1) + 's';
          miniHearts.appendChild(s);
        }
      }

      function spawnMiniHeart() {
        var d = document.createElement('div');
        d.className = 'mini-heart';
        d.style.left = (4 + Math.random() * 92) + '%';
        d.style.top = (6 + Math.random() * 86) + '%';
        d.style.setProperty('--s', (26 + Math.random() * 42) + 'px');
        d.style.setProperty('--r', (Math.random() * 50 - 25) + 'deg');
        d.innerHTML = HEART_SVG.replace('{C}', PALETTE[Math.floor(Math.random() * PALETTE.length)]);
        miniHearts.appendChild(d);
      }

      at(3300, function () { heartArea.classList.add('filled'); });
      at(3620, function () { heartArea.classList.add('pop'); sparkleBurst(); });
      at(4080, function () {
        heartArea.classList.add('zoom');
        heartScreen.classList.add('active');
        for (var i = 0; i < 28; i++) {
          (function (k) { at(k * 32, spawnMiniHeart); })(i);
        }
      });
      at(5750, function () {
        introStage.classList.add('fade-out');
        heartScreen.classList.add('fade-out');
        miniHearts.classList.add('fade-out');
      });
      at(6500, endIntro);

      skipBtn.addEventListener('click', endIntro);
    }
  }

  // ===== 页面小人场景 =====
  if (isPost) {
    var commentEl = document.getElementById('waline-container');
    function onScroll() {
      if (!commentEl) return;
      var rect = commentEl.getBoundingClientRect();
      if (rect.top < window.innerHeight - 100) {
        showScene('post-bottom');
      } else {
        showScene('post-top');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    showScene('post-top');
    onScroll();
  } else if (!introStage || sessionStorage.getItem('intro-played')) {
    showScene('home');
  }
})();
</script>
